# Switchyard as a systemd --user service (Linux). Install:
#
#   mkdir -p ~/.config/systemd/user
#   cp packaging/switchyard.service ~/.config/systemd/user/
#   sed -i "s|^ExecStart=.*|ExecStart=$(command -v node) server.js|" ~/.config/systemd/user/switchyard.service
#   sed -i "s|^WorkingDirectory=.*|WorkingDirectory=$PWD|" ~/.config/systemd/user/switchyard.service   # run from the clone
#   loginctl enable-linger "$USER"        # keeps it running when you're not logged in
#   systemctl --user daemon-reload
#   systemctl --user enable --now switchyard
#
# Logs: journalctl --user -u switchyard -f
#
# The ExecStart path is absolute on purpose: a systemd unit does not source your shell, so an
# nvm- or fnm-managed `node` is not on its PATH. Re-run that sed line after a node upgrade.
#
# SSH: the unit doesn't get your login session's ssh-agent. Use keys without a passphrase for these
# servers, or run a user-level agent and uncomment the Environment line below (for example with
# `systemctl --user enable --now ssh-agent`, where your distribution ships that unit).
[Unit]
Description=Switchyard — live roadmap of Claude Code and Codex sessions across your servers
Documentation=https://github.com/EndlessCG/switchyard
After=network-online.target

[Service]
Type=simple
# Where you cloned Switchyard (%h is your home directory), and your node: see the sed lines above.
WorkingDirectory=%h/switchyard
ExecStart=/usr/bin/node server.js
#Environment=SSH_AUTH_SOCK=%t/ssh-agent.socket
Restart=always
RestartSec=5
# The hub only ever listens on 127.0.0.1, so there is nothing to expose; it holds one SSH
# connection per host and retries with backoff by itself when a server is unreachable.

[Install]
WantedBy=default.target
